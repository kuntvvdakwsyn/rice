{
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 5,
    "margin-bottom": 5,
    "margin-right": 5,
    "height": 50,
    "include": [
        "~/.config/waybar/modules.jsonc"
    ],
    "modules-left": [
        "custom/power",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "memory",
        "battery",
        "custom/notification"
    ]
}
